---
import { pt, en } from '../data/translations';

interface Props { lang?: 'pt' | 'en'; }
const { lang = 'pt' } = Astro.props as Props;
const locale = lang === 'en' ? en : pt;
const content = locale.hero;
---

<section
  id="inicio"
  class="relative isolate overflow-hidden border-b border-white/5"
>
  <div class="pointer-events-none absolute -left-40 top-20 -z-10 h-96 w-96 rounded-full bg-[#A12D21]/10 blur-[120px]"></div>

  <div class="pointer-events-none absolute -right-40 bottom-0 -z-10 h-96 w-96 rounded-full bg-[#1572B6]/10 blur-[120px]"></div>

  <div class="mx-auto grid min-h-[calc(100vh-5rem)] w-[min(100%-2rem,1440px)] items-center gap-16 py-20 lg:grid-cols-[1.15fr_0.85fr] lg:py-24">
    <div class="flex flex-col items-start">
      <div class="mb-8 inline-flex items-center gap-3 border border-[#1572B6]/30 bg-[#1572B6]/5 px-4 py-2">
        <span class="relative flex h-2 w-2">
          <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-[#1572B6] opacity-50"></span>
          <span class="relative inline-flex h-2 w-2 rounded-full bg-[#1572B6]"></span>
        </span>

        <span class="font-mono text-xs tracking-wide text-slate-300 sm:text-sm">
          {content.availability}
        </span>
      </div>

      <p class="mb-3 font-mono text-sm tracking-widest text-[#1572B6] sm:text-base">
        {content.greeting}
      </p>

      <h1 class="max-w-3xl text-5xl font-extrabold leading-[1.05] tracking-tight sm:text-6xl lg:text-7xl">
        <span class="block text-[#E8EDF4]">{content.name}</span>
        <span class="mt-2 block text-[#A12D21]">{content.surname}</span>
      </h1>

      <div class="mt-8 space-y-2">
        <h2 class="text-xl font-semibold text-[#E8EDF4] sm:text-2xl">
          {content.role}
        </h2>

        <p class="text-base text-slate-400 sm:text-lg">{content.transition}</p>
      </div>

      <p class="mt-6 max-w-2xl text-base leading-8 text-slate-400 sm:text-lg">
        {content.description}
      </p>

      <div class="mt-9 flex w-full flex-col gap-3 sm:w-auto sm:flex-row">
        <a
          href={content.primaryAction.href}
          class="inline-flex min-h-12 items-center justify-center gap-3 bg-[#A12D21] px-6 py-3 text-sm font-semibold text-white transition-colors hover:bg-[#86251C]"
        >
          {content.primaryAction.label}
          <span aria-hidden="true">↓</span>
        </a>

        <a
          href={content.secondaryAction.href}
          class="inline-flex min-h-12 items-center justify-center gap-3 border border-[#1572B6]/50 px-6 py-3 text-sm font-semibold text-[#E8EDF4] transition-colors hover:border-[#1572B6] hover:bg-[#1572B6]/10"
        >
          {content.secondaryAction.label}
          <span aria-hidden="true" class="text-[#1572B6]">
            ↗
          </span>
        </a>
      </div>

      <div class="mt-10 flex flex-wrap items-center gap-x-6 gap-y-3 border-t border-white/10 pt-6">
        {content.socialLinks.map((link) => (
          <a
            href={link.href}
            class="font-mono text-sm text-slate-500 transition-colors hover:text-[#1572B6]"
            target={link.href.startsWith('http') ? '_blank' : undefined}
            rel={
              link.href.startsWith('http') ? 'noopener noreferrer' : undefined
            }
          >
            {link.label}
            <span class="ml-1 text-[#A12D21]" aria-hidden="true">
              ↗
            </span>
          </a>
        ))}
      </div>
    </div>

    <div class="relative mx-auto w-full max-w-lg">
      <div class="absolute -inset-4 -z-10 border border-[#1572B6]/10"></div>

      <div class="border border-white/10 bg-[#151B24]">
        <div class="flex items-center justify-between border-b border-white/10 px-5 py-4">
          <div class="flex items-center gap-2" aria-hidden="true">
            <span class="h-2.5 w-2.5 rounded-full bg-[#A12D21]"></span>
            <span class="h-2.5 w-2.5 rounded-full bg-[#1572B6]"></span>
            <span class="h-2.5 w-2.5 rounded-full bg-slate-600"></span>
          </div>

          <span class="font-mono text-xs text-slate-500">{content.visual.windowTitle}</span>
        </div>

        <div class="space-y-8 p-6 sm:p-8">
          <div>
            <p class="font-mono text-xs tracking-widest text-[#A12D21]">
              // {content.visual.label}
            </p>

            <h3 class="mt-3 text-2xl font-bold tracking-tight text-[#E8EDF4] sm:text-3xl">
              {content.visual.value}
            </h3>

            <p class="mt-2 text-sm leading-6 text-slate-400">
              {content.visual.explanation}
            </p>
          </div>

          <div class="data-flow-board" aria-label={content.visual.pipeline.ariaLabel}>
            <div class="data-flow-board-head">
              <span>{content.visual.pipeline.heading}</span>
              <span><i></i> {content.visual.pipeline.liveLabel}</span>
            </div>
            <div class="data-flow-track" aria-hidden="true">
              <div class="data-flow-node data-node-blue"><span>{content.visual.stages[0].code}</span></div>
              <div class="data-flow-rail"><i></i><i></i><i></i></div>
              <div class="data-flow-node data-node-red"><span>{content.visual.stages[1].code}</span></div>
              <div class="data-flow-rail data-rail-blue"><i></i><i></i><i></i></div>
              <div class="data-flow-node data-node-blue"><span>{content.visual.stages[2].code}</span></div>
            </div>
            <div class="data-flow-labels" aria-hidden="true">
              <span>{content.visual.pipeline.source}</span><span>{content.visual.pipeline.transform}</span><span>{content.visual.pipeline.query}</span>
            </div>
          </div>

          <div class="space-y-0">
            {content.visual.stages.map((stage, index) => (
              <div>
                <div class="flex items-center gap-3">
                  <span
                    class:list={[
                      'flex h-10 w-10 shrink-0 items-center justify-center border font-mono text-sm',
                      index === 1
                        ? 'border-[#A12D21]/30 bg-[#A12D21]/10 text-[#A12D21]'
                        : 'border-[#1572B6]/30 bg-[#1572B6]/10 text-[#1572B6]',
                    ]}
                  >
                    {stage.code}
                  </span>
                  <div>
                    <p class="text-sm font-semibold text-[#E8EDF4]">{stage.title}</p>
                    <p class="text-xs text-slate-500">{stage.detail}</p>
                  </div>
                </div>
                {index < content.visual.stages.length - 1 && (
                  <div
                    class:list={[
                      'ml-5 h-8 w-px bg-linear-to-b',
                      index === 0
                        ? 'from-[#1572B6] to-[#A12D21]'
                        : 'from-[#A12D21] to-[#1572B6]',
                    ]}
                    aria-hidden="true"
                  ></div>
                )}
              </div>
            ))}
          </div>

          <div class="flex flex-wrap gap-2 border-t border-white/10 pt-5">
            {content.visual.technologies.map((technology) => (
              <span class="border border-white/10 px-3 py-1.5 font-mono text-xs text-slate-400">
                {technology}
              </span>
            ))}
          </div>

          <div class="flex items-center gap-3 border-l-2 border-[#A12D21] pl-4">
            <span class="text-sm text-slate-400">{content.visual.status}</span>
          </div>
        </div>
      </div>

      <span class="absolute -bottom-3 -right-3 h-6 w-6 border-b-2 border-r-2 border-[#A12D21]"></span>
      <span class="absolute -left-3 -top-3 h-6 w-6 border-l-2 border-t-2 border-[#1572B6]"></span>
    </div>
  </div>

  <div class="mx-auto flex w-[min(100%-2rem,1440px)] items-center gap-3 pb-6 font-mono text-[10px] uppercase tracking-[0.2em] text-slate-600">
    <span class="h-px w-8 bg-[#A12D21]"></span>
    <span>{content.visual.footer}</span>
  </div>
</section>

<style>
  .data-flow-board {
    padding: 15px 16px 12px;
    border: 1px solid rgb(255 255 255 / 9%);
    background: rgb(11 14 20 / 55%);
  }

  .data-flow-board-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    color: #777f8c;
    font: 9px 'DM Mono', monospace;
    letter-spacing: 0.12em;
  }

  .data-flow-board-head span:last-child {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: #779e89;
    font-size: 8px;
  }

  .data-flow-board-head i {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: #77a98a;
    box-shadow: 0 0 7px rgb(119 169 138 / 45%);
  }

  .data-flow-track {
    display: flex;
    align-items: center;
    margin-top: 17px;
  }

  .data-flow-node {
    display: grid;
    width: 38px;
    height: 38px;
    flex: 0 0 38px;
    place-items: center;
    border: 1px solid;
    font: 10px 'DM Mono', monospace;
    background: #111720;
  }

  .data-node-blue {
    border-color: rgb(21 114 182 / 42%);
    color: #60a9d8;
  }

  .data-node-red {
    border-color: rgb(161 45 33 / 45%);
    color: #d56b5d;
    background: #191416;
  }

  .data-flow-rail {
    position: relative;
    height: 1px;
    flex: 1 1 auto;
    background: #593a38;
  }

  .data-flow-rail i {
    position: absolute;
    top: -2.5px;
    left: 0;
    width: 6px;
    height: 6px;
    border-radius: 1px;
    background: #d45c4d;
    box-shadow: 0 0 9px rgb(212 92 77 / 55%);
    animation: data-flow-travel 2.8s linear infinite;
  }

  .data-flow-rail i:nth-child(2) { animation-delay: 0.93s; }
  .data-flow-rail i:nth-child(3) { animation-delay: 1.86s; }

  .data-rail-blue {
    background: #25465d;
  }

  .data-rail-blue i {
    background: #4b9ed1;
    box-shadow: 0 0 9px rgb(75 158 209 / 55%);
  }

  .data-flow-labels {
    display: grid;
    grid-template-columns: 38px 1fr 38px 1fr 38px;
    margin-top: 8px;
    color: #727984;
    font: 8px 'DM Mono', monospace;
    text-align: center;
  }

  .data-flow-labels span:nth-child(1) { grid-column: 1; }
  .data-flow-labels span:nth-child(2) { grid-column: 3; }
  .data-flow-labels span:nth-child(3) { grid-column: 5; }

  @keyframes data-flow-travel {
    0% { left: 0; opacity: 0; }
    10% { opacity: 1; }
    88% { opacity: 1; }
    100% { left: calc(100% - 6px); opacity: 0; }
  }

  @media (prefers-reduced-motion: reduce) {
    .data-flow-rail i { animation: none; left: calc(50% - 3px); }
  }
</style>
