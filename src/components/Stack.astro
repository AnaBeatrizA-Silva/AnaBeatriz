---
import { stack } from '../data/stack';
---

<section
  id="conhecimentos"
  class="border-b border-white/5 bg-[#0E121A] py-24 sm:py-28"
>
  <div class="mx-auto w-[min(100%-2rem,1200px)]">
    <header class="mb-14 max-w-3xl">
      <p class="mb-4 flex items-center gap-3 font-mono text-xs tracking-[0.2em] text-[#1572B6]">
        <span class="h-px w-8 bg-[#1572B6]"></span>
        {stack.eyebrow}
      </p>

      <h2 class="text-3xl font-bold tracking-tight text-[#E8EDF4] sm:text-4xl">
        {stack.title}
      </h2>

      <p class="mt-5 max-w-2xl text-base leading-8 text-slate-400 sm:text-lg">
        {stack.description}
      </p>
    </header>

    <div class="grid gap-5 md:grid-cols-2">
      {stack.categories.map((category, index) => (
        <article class="border border-white/10 bg-[#151B24]/50 p-6 transition-colors hover:border-white/20 sm:p-8">
          <div class="mb-6 flex items-start justify-between gap-4">
            <div>
              <p
                class:list={[
                  'mb-3 font-mono text-xs tracking-wider',
                  category.accent === 'red'
                    ? 'text-[#A12D21]'
                    : 'text-[#1572B6]',
                ]}
              >
                CATEGORY_{String(index + 1).padStart(2, '0')}
              </p>

              <h3 class="text-xl font-semibold text-[#E8EDF4]">
                {category.title}
              </h3>

              <p class="mt-2 text-sm leading-6 text-slate-500">
                {category.description}
              </p>
            </div>

            <span
              class:list={[
                'mt-1 h-2.5 w-2.5 shrink-0',
                category.accent === 'red' ? 'bg-[#A12D21]' : 'bg-[#1572B6]',
              ]}
            ></span>
          </div>

          <div class="space-y-0">
            {category.technologies.map((technology) => (
              <div class="flex flex-col gap-1 border-t border-white/5 py-4 sm:flex-row sm:items-center sm:justify-between sm:gap-4">
                <span class="text-sm font-medium text-slate-200">
                  {technology.name}
                </span>

                <span class="font-mono text-xs text-slate-500">
                  {technology.level}
                </span>
              </div>
            ))}
          </div>
        </article>
      ))}
    </div>

    <div class="mt-8 border border-[#1572B6]/20 bg-[#1572B6]/5 p-6 sm:p-8">
      <div class="flex flex-col gap-6 sm:flex-row sm:items-center sm:justify-between">
        <div>
          <p class="font-mono text-xs tracking-widest text-[#1572B6]">
            COMUNICAÇÃO
          </p>

          <h3 class="mt-2 text-lg font-semibold text-[#E8EDF4]">Idiomas</h3>
        </div>

        <div class="flex flex-wrap gap-3">
          {stack.languages.map((language) => (
            <div class="border border-white/10 bg-[#0B0E14]/60 px-4 py-3">
              <p class="text-sm font-medium text-[#E8EDF4]">{language.name}</p>

              <p class="mt-1 text-xs text-slate-500">{language.proficiency}</p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>
