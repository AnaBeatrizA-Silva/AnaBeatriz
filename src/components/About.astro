---
import { about } from '../data/about';
---

<section id="sobre" class="border-b border-white/5 bg-[#0B0E14] py-24 sm:py-28">
  <div class="mx-auto w-[min(100%-2rem,1200px)]">
    <div class="mb-14 grid gap-8 lg:grid-cols-[0.7fr_1.3fr] lg:gap-16">
      <div>
        <p class="mb-4 flex items-center gap-3 font-mono text-xs tracking-[0.2em] text-[#1572B6]">
          <span class="h-px w-8 bg-[#1572B6]"></span>
          {about.eyebrow}
        </p>

        <h2 class="max-w-md text-3xl font-bold leading-tight tracking-tight text-[#E8EDF4] sm:text-4xl">
          {about.title}
        </h2>
      </div>

      <div class="space-y-5">
        {about.paragraphs.map((paragraph) => (
          <p class="text-base leading-8 text-slate-400 sm:text-lg">
            {paragraph}
          </p>
        ))}
      </div>
    </div>

    <div class="grid gap-4 md:grid-cols-3">
      {about.principles.map((principle) => (
        <article class="group border border-white/10 bg-[#151B24]/60 p-6 transition-colors hover:border-[#1572B6]/40 sm:p-7">
          <div class="mb-8 flex items-center justify-between">
            <span
              class:list={[
                'font-mono text-sm',
                principle.accent === 'red'
                  ? 'text-[#A12D21]'
                  : 'text-[#1572B6]',
              ]}
            >
              {principle.number}
            </span>

            <span
              class:list={[
                'h-2 w-2 rounded-full transition-transform group-hover:scale-150',
                principle.accent === 'red' ? 'bg-[#A12D21]' : 'bg-[#1572B6]',
              ]}
            ></span>
          </div>

          <h3 class="mb-3 text-lg font-semibold text-[#E8EDF4]">
            {principle.title}
          </h3>

          <p class="text-sm leading-7 text-slate-400">
            {principle.description}
          </p>
        </article>
      ))}
    </div>

    <div class="mt-8 grid gap-5 border border-[#A12D21]/30 bg-[#151B24]/60 p-6 sm:p-8 md:grid-cols-[auto_1fr] md:items-center md:gap-8">
      <div class="flex h-14 w-14 items-center justify-center border border-[#A12D21]/40 bg-[#A12D21]/10 font-mono text-sm text-[#A12D21]">
        &lt;/&gt;
      </div>

      <div>
        <p class="mb-2 font-mono text-xs tracking-widest text-[#A12D21]">
          {about.focus.label}
        </p>

        <h3 class="text-lg font-semibold text-[#E8EDF4] sm:text-xl">
          {about.focus.title}
        </h3>

        <p class="mt-2 max-w-3xl text-sm leading-7 text-slate-400 sm:text-base">
          {about.focus.description}
        </p>
      </div>
    </div>
  </div>
</section>
