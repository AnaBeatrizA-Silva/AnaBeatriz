---
import { projects, projectsSection } from '../data/projects';
---

<section
  id="projetos"
  class="border-b border-white/5 bg-[#0E121A] py-24 sm:py-28"
>
  <div class="mx-auto w-[min(100%-2rem,1200px)]">
    <header class="mb-12 flex flex-col gap-6 md:flex-row md:items-end md:justify-between">
      <div class="max-w-2xl">
        <p class="mb-4 flex items-center gap-3 font-mono text-xs tracking-[0.2em] text-[#A12D21]">
          <span class="h-px w-8 bg-[#A12D21]"></span>
          {projectsSection.eyebrow}
        </p>

        <h2 class="text-3xl font-bold tracking-tight text-[#E8EDF4] sm:text-4xl">
          {projectsSection.title}
        </h2>

        <p class="mt-5 text-base leading-8 text-slate-400 sm:text-lg">
          {projectsSection.description}
        </p>
      </div>

      <a
        href={projectsSection.action.href}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex w-fit shrink-0 items-center gap-3 border border-[#1572B6]/40 px-5 py-3 text-sm font-medium text-[#E8EDF4] transition-colors hover:border-[#1572B6] hover:bg-[#1572B6]/10"
      >
        {projectsSection.action.label}
        <span class="text-[#1572B6]" aria-hidden="true">
          ↗
        </span>
      </a>
    </header>

    {projects.length > 0 ? (
      <div class="grid gap-5 md:grid-cols-2">
        {projects.map((project, index) => (
          <article class="group flex h-full flex-col border border-white/10 bg-[#151B24]/50 p-6 transition-colors hover:border-[#1572B6]/40 sm:p-8">
            <div class="mb-8 flex items-center justify-between">
              <span class="font-mono text-xs text-[#1572B6]">
                PROJECT_{String(index + 1).padStart(2, '0')}
              </span>

              <span class="border border-white/10 px-3 py-1 font-mono text-xs text-slate-500">
                {project.category}
              </span>
            </div>

            <h3 class="text-xl font-bold text-[#E8EDF4] transition-colors group-hover:text-[#1572B6]">
              {project.title}
            </h3>

            <p class="mt-4 flex-1 text-sm leading-7 text-slate-400">
              {project.description}
            </p>

            <div class="mt-6 flex flex-wrap gap-2">
              {project.technologies.map((technology) => (
                <span class="border border-white/10 px-2.5 py-1.5 font-mono text-xs text-slate-400">
                  {technology}
                </span>
              ))}
            </div>

            {(project.repositoryUrl || project.demoUrl) && (
              <div class="mt-7 flex flex-wrap gap-5 border-t border-white/10 pt-5">
                {project.repositoryUrl && (
                  <a
                    href={project.repositoryUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="text-sm text-slate-400 transition-colors hover:text-[#1572B6]"
                  >
                    Repositório <span aria-hidden="true">↗</span>
                  </a>
                )}

                {project.demoUrl && (
                  <a
                    href={project.demoUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="text-sm text-slate-400 transition-colors hover:text-[#A12D21]"
                  >
                    Demonstração <span aria-hidden="true">↗</span>
                  </a>
                )}
              </div>
            )}
          </article>
        ))}
      </div>
    ) : (
      <div class="relative overflow-hidden border border-dashed border-white/15 bg-[#151B24]/30 px-6 py-14 text-center sm:px-12 sm:py-20">
        <span class="pointer-events-none absolute -right-12 -top-12 h-40 w-40 rounded-full bg-[#1572B6]/5 blur-3xl"></span>

        <div class="relative mx-auto flex max-w-xl flex-col items-center">
          <span class="mb-6 flex h-14 w-14 items-center justify-center border border-[#1572B6]/30 bg-[#1572B6]/10 font-mono text-sm text-[#1572B6]">
            {'{ }'}
          </span>

          <h3 class="text-xl font-semibold text-[#E8EDF4]">
            {projectsSection.emptyState.title}
          </h3>

          <p class="mt-3 text-sm leading-7 text-slate-400">
            {projectsSection.emptyState.description}
          </p>

          <a
            href={projectsSection.action.href}
            target="_blank"
            rel="noopener noreferrer"
            class="mt-7 inline-flex items-center gap-3 border border-[#A12D21]/50 px-5 py-3 text-sm font-medium text-[#E8EDF4] transition-colors hover:border-[#A12D21] hover:bg-[#A12D21]/10"
          >
            Explorar repositórios
            <span class="text-[#A12D21]" aria-hidden="true">
              ↗
            </span>
          </a>
        </div>
      </div>
    )}
  </div>
</section>
