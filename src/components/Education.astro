---
import { education } from '../data/education';
---

<section
  id="formacao"
  class="border-b border-white/5 bg-[#0B0E14] py-24 sm:py-28"
>
  <div class="mx-auto w-[min(100%-2rem,1200px)]">
    <header class="mb-14 max-w-2xl">
      <p class="mb-4 flex items-center gap-3 font-mono text-xs tracking-[0.2em] text-[#A12D21]">
        <span class="h-px w-8 bg-[#A12D21]"></span>
        {education.eyebrow}
      </p>

      <h2 class="text-3xl font-bold tracking-tight text-[#E8EDF4] sm:text-4xl">
        {education.title}
      </h2>

      <p class="mt-5 text-base leading-8 text-slate-400 sm:text-lg">
        {education.description}
      </p>
    </header>

    <div class="grid gap-5 lg:grid-cols-[0.85fr_1.15fr]">
      {education.entries.map((entry, index) => (
        <article
          class:list={[
            'relative border bg-[#151B24]/50 p-6 transition-colors hover:border-white/20 sm:p-8',
            index === 0
              ? 'border-[#1572B6]/40 lg:row-span-2'
              : 'border-white/10',
          ]}
        >
          <div class="mb-8 flex items-center justify-between gap-4">
            <span
              class:list={[
                'font-mono text-xs tracking-wider',
                entry.accent === 'red'
                  ? 'text-[#A12D21]'
                  : 'text-[#1572B6]',
              ]}
            >
              EDUCATION_{String(index + 1).padStart(2, '0')}
            </span>

            <span class="border border-white/10 px-3 py-1.5 font-mono text-xs text-slate-500">
              {entry.period}
            </span>
          </div>

          <p class="mb-3 font-mono text-xs text-slate-500">
            {entry.type}
          </p>

          <h3
            class:list={[
              'font-bold leading-snug text-[#E8EDF4]',
              index === 0 ? 'text-2xl sm:text-3xl' : 'text-xl',
            ]}
          >
            {entry.course}
          </h3>

          <p class="mt-3 text-sm font-medium text-[#1572B6]">
            {entry.institution}
          </p>

          <p class="mt-5 text-sm leading-7 text-slate-400">
            {entry.description}
          </p>

          <div class="mt-7 border-t border-white/10 pt-5">
            <span
              class:list={[
                'inline-flex items-center gap-2 text-xs font-medium',
                entry.status === 'Em andamento'
                  ? 'text-[#1572B6]'
                  : 'text-slate-400',
              ]}
            >
              <span
                class:list={[
                  'h-1.5 w-1.5 rounded-full',
                  entry.status === 'Em andamento'
                    ? 'bg-[#1572B6]'
                    : 'bg-slate-500',
                ]}
              ></span>

              {entry.status}
            </span>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>