---
import { pt, en } from '../data/translations';

const publicBase = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
interface Props { lang?: 'pt' | 'en'; }
const { lang = 'pt' } = Astro.props as Props;
const locale = lang === 'en' ? en : pt;
const footer = locale.footer;
---

<footer class="border-t border-white/10 bg-[#0B0E14]">
  <div class="mx-auto flex w-[min(100%-2rem,1200px)] flex-col gap-5 py-7 sm:flex-row sm:items-center sm:justify-between">
    <a
      href="#inicio"
      class="inline-flex w-fit items-center gap-3"
      aria-label={footer.backLabel}
    >
      <img src={`${publicBase}logo.svg`} alt={locale.nav.logoAlt} width="56" height="32" />
      <span class="h-4 w-px bg-white/15"></span>
      <span class="font-mono text-[10px] uppercase tracking-wider text-slate-500">
        {footer.tagline[0]} <span class="text-[#A12D21]">/</span> {footer.tagline[1]}
      </span>
    </a>

    <p class="m-0 text-xs text-slate-500">
      {footer.note}
    </p>

    <div class="flex items-center justify-between gap-5 font-mono text-[10px] text-slate-500 sm:justify-end">
      <span>© {new Date().getFullYear()} {footer.copyrightName}</span>
      <a href="#inicio" class="transition-colors hover:text-[#1572B6]">
        {footer.backToTop}
      </a>
    </div>
  </div>
</footer>
